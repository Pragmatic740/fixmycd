# Postgres connection (Neon, Vercel Postgres, etc.)
DATABASE_URL=postgresql://user:password@host:5432/fixmydistrict

# Vercel Blob for image/video uploads (optional locally — falls back to data URLs)
BLOB_READ_WRITE_TOKEN=

# Optional: Google Maps (Phase 6 — Leaflet is default)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Optional: OpenAI for AI summaries on report accept
OPENAI_API_KEY=

# Optional: Resend for email notifications (comments, upvotes, endorsements,
# status changes, account approval, beta launch). Without RESEND_API_KEY emails
# are skipped and logged.
RESEND_API_KEY=
# Must be a sender on a domain verified in Resend (onboarding@resend.dev only
# delivers to the Resend account owner).
EMAIL_FROM=
# Public site URL used for links in emails, e.g. https://your-app.vercel.app
NEXT_PUBLIC_BASE_URL=

# Secret for signing one-click unsubscribe links in emails (any long random
# string, e.g. `openssl rand -base64 32`). Without it emails have no
# unsubscribe link (the profile setting still works).
UNSUBSCRIBE_SECRET=

# Salt for hashing visitors in share-link view counts (long random string).
# Without it a random per-instance salt is used.
HASH_SALT=

# Contact URL or email sent to OpenStreetMap Nominatim in the User-Agent
# (their usage policy asks for one). Defaults to the GitHub repository.
GEOCODER_CONTACT=

# Tests only: a Postgres server the test suites may create/drop databases on.
# Never point this at production.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
